# mock = demonstration data stored in the browser (no Firebase/backend needed)
# live = Firebase Auth + Cloud Firestore + FastAPI backend
VITE_DATA_MODE=mock
VITE_API_BASE_URL=http://localhost:8000

# Firebase web app config (Firebase console > Project settings > Your apps).
# Only the values this app uses (Auth + Firestore). They identify your project and are not secrets;
# security comes from Firestore rules + backend token checks. NEVER put a service-account key here.
VITE_FIREBASE_API_KEY="AIzaSyC20eJn1r3jq7tzppjhuY3waznDDNvHUKA"
VITE_FIREBASE_AUTH_DOMAIN="privacysurvey.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="privacysurvey"
VITE_FIREBASE_APP_ID="1:87531289795:web:fb07aa6e3da7100d6eb676"

# Optional hero media. Leave empty to use the built-in illustration.
# VITE_HERO_IMAGE_URL: a licensed photograph (e.g. /hero-coast.jpg placed in /public). VITE_HERO_VIDEO_URL: a short muted loop (skipped when the
# visitor prefers reduced motion). The image/illustration is always the fallback.
VITE_HERO_IMAGE_URL=
VITE_HERO_VIDEO_URL=